PORT=8082
# development (por defecto) o production: en production los registros salen en JSON y la semilla
# no corre salvo SEMILLA_DEMO=si (solo carga)
NODE_ENV=development
# Con TLS se activa en la propia URL: mongodb+srv://… o ?tls=true (601)
MONGODB_URI=mongodb://localhost:27017/materiales_db?replicaSet=rs0
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=supervision
AUDIENCIA=plataforma-api
# Con TLS: amqps://usuario:clave@host:5671 (601)
RABBITMQ_URL=amqp://usuario:clave@localhost:5672
# Vacío: solo la llaman servicios y la app (no atiende al navegador)
CORS_ORIGENES=
# Opcional (ensayo local de la 601): ruta de una CA adicional para MongoDB y RabbitMQ con TLS
# NODE_EXTRA_CA_CERTS=/certificados/ca.crt
# Solo en un entorno de demostración: permite que la semilla cargue (nunca vacía) con
# NODE_ENV=production o una base que no es local (601)
# SEMILLA_DEMO=si
# 603: «si» suma la historia de demostración (obras 4 a 6) a los datos de prueba
# SEMILLA_HISTORIA=si
